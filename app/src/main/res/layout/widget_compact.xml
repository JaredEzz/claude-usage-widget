<?xml version="1.0" encoding="utf-8"?>
<!-- Compact layout for small widget sizes: badge + three tight meter rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="2dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="22dp"
        android:background="@drawable/widget_badge_bg"
        android:contentDescription="OpenCode"
        android:padding="2dp"
        android:src="@drawable/ic_opencode_mark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ibm_plex_mono_semibold"
                android:text="5H"
                android:textColor="@color/widget_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/c1_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_semibold"
                android:text="–"
                android:textColor="@color/widget_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/c1_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:indeterminateOnly="false"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/meter_bar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ibm_plex_mono_semibold"
                android:text="1W"
                android:textColor="@color/widget_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/c2_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_semibold"
                android:text="–"
                android:textColor="@color/widget_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/c2_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:indeterminateOnly="false"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/meter_bar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ibm_plex_mono_semibold"
                android:text="30D"
                android:textColor="@color/widget_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/c3_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_semibold"
                android:text="–"
                android:textColor="@color/widget_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/c3_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:indeterminateOnly="false"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/meter_bar" />
    </LinearLayout>
</LinearLayout>
